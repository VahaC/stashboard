pipeline {
    agent none

    options {
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'VERSION', defaultValue: '', description: 'Version to publish, e.g. 10.11.0')
    }

    stages {
        stage('Validate') {
            agent any
            steps {
                script {
                    if (!params.VERSION?.trim()) {
                        error 'VERSION parameter is required'
                    }
                }
            }
        }

        stage('Checkout') {
            agent any
            steps {
                git branch: 'main',
                    credentialsId: 'github-pat',
                    url: 'https://github.com/VahaC/stashboard.git'
                stash includes: '**', name: 'source'
            }
        }

        stage('.NET Build & Test') {
            agent {
                docker { image 'mcr.microsoft.com/dotnet/sdk:10.0' }
            }
            steps {
                unstash 'source'
                sh 'dotnet restore Stashboard.slnx'
                sh 'dotnet build Stashboard.slnx -c Release --no-restore'
                sh 'dotnet test tests/Stashboard.Tests --no-build -c Release --logger "trx;LogFileName=test-results.trx"'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/test-results.trx'
                }
            }
        }

        stage('Frontend Test') {
            agent {
                docker { image 'node:22-alpine' }
            }
            steps {
                unstash 'source'
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run test'
                }
            }
        }

        stage('Buildx Publish') {
            // Only reached if both build/test stages above succeeded.
            agent any
            steps {
                git branch: 'main',
                    credentialsId: 'github-pat',
                    url: 'https://github.com/VahaC/stashboard.git'
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                    sh '''
                        printf '%s' "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
                        docker buildx create --name ci-multiarch-stashboard --driver docker-container --bootstrap 2>/dev/null || true
                        docker buildx use ci-multiarch-stashboard
                        docker buildx build --platform linux/amd64,linux/arm64 \
                          -t vahac/stashboard:${VERSION} \
                          -t vahac/stashboard:latest \
                          --push .
                    '''
                }
            }
            post {
                always {
                    sh 'docker buildx rm ci-multiarch-stashboard --force || true'
                }
            }
        }
    }

    post {
        failure {
            node('built-in') {
                withCredentials([
                    string(credentialsId: 'telegram-bot-token', variable: 'TG_TOKEN'),
                    string(credentialsId: 'telegram-chat-id', variable: 'TG_CHAT')
                ]) {
                    sh '''
                        curl -s -X POST https://api.telegram.org/bot${TG_TOKEN}/sendMessage \
                          -d chat_id=${TG_CHAT} \
                          -d text="❌ Publish FAILED for version ${VERSION}: ${BUILD_URL}"
                    '''
                }
            }
        }
        success {
            node('built-in') {
                withCredentials([
                    string(credentialsId: 'telegram-bot-token', variable: 'TG_TOKEN'),
                    string(credentialsId: 'telegram-chat-id', variable: 'TG_CHAT')
                ]) {
                    sh '''
                        curl -s -X POST https://api.telegram.org/bot${TG_TOKEN}/sendMessage \
                          -d chat_id=${TG_CHAT} \
                          -d text="✅ Published vahac/stashboard:${VERSION}"
                    '''
                }
            }
        }
    }
}
