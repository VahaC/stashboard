{
  "id": "bazarr",
  "name": "Bazarr",
  "description": "Subtitle management companion for Sonarr/Radarr.",
  "category": "Media automation",
  "icon": "bazarr",
  "projectName": "bazarr",
  "variables": [
    {
      "key": "CONFIG_PATH",
      "label": "Config directory (host)",
      "type": "path",
      "hint": null,
      "default": "./bazarr/config",
      "required": false,
      "generate": false
    },
    {
      "key": "DATA_PATH",
      "label": "Media/downloads (host)",
      "type": "path",
      "hint": null,
      "default": "./data",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "6767",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "bazarr",
      "image": "lscr.io/linuxserver/bazarr:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:6767"
      ],
      "volumes": [
        "${CONFIG_PATH}:/config",
        "${DATA_PATH}:/data"
      ],
      "environment": [
        {
          "name": "PUID",
          "value": "1000"
        },
        {
          "name": "PGID",
          "value": "1000"
        },
        {
          "name": "TZ",
          "value": "Etc/UTC"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://docs.linuxserver.io/images/docker-bazarr"
}
