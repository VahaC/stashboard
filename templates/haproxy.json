{
  "id": "haproxy",
  "name": "HAProxy",
  "description": "Reliable, high-performance TCP/HTTP load balancer.",
  "category": "Networking & proxies",
  "icon": "haproxy",
  "projectName": "haproxy",
  "variables": [
    {
      "key": "CONFIG_PATH",
      "label": "Config directory (host)",
      "type": "path",
      "hint": null,
      "default": "./haproxy",
      "required": false,
      "generate": false
    },
    {
      "key": "HTTP_PORT",
      "label": "HTTP port",
      "type": "port",
      "hint": null,
      "default": "80",
      "required": false,
      "generate": false
    },
    {
      "key": "HTTPS_PORT",
      "label": "HTTPS port",
      "type": "port",
      "hint": null,
      "default": "443",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "haproxy",
      "image": "haproxy:2.9",
      "restart": "unless-stopped",
      "ports": [
        "${HTTP_PORT}:80",
        "${HTTPS_PORT}:443"
      ],
      "volumes": [
        "${CONFIG_PATH}:/usr/local/etc/haproxy:ro"
      ],
      "environment": [],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": "Place a haproxy.cfg in the config directory before starting.",
  "documentation": "https://hub.docker.com/_/haproxy"
}
