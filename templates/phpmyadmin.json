{
  "id": "phpmyadmin",
  "name": "phpMyAdmin",
  "description": "Web administration tool for MySQL / MariaDB.",
  "category": "Databases & caches",
  "icon": "phpmyadmin",
  "projectName": "phpmyadmin",
  "variables": [
    {
      "key": "DB_HOST",
      "label": "Database host",
      "type": "text",
      "hint": null,
      "default": "db",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "8080",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "phpmyadmin",
      "image": "phpmyadmin:5",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:80"
      ],
      "volumes": [],
      "environment": [
        {
          "name": "PMA_HOST",
          "value": "${DB_HOST}"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://hub.docker.com/_/phpmyadmin"
}
