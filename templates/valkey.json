{
  "id": "valkey",
  "name": "Valkey",
  "description": "High-performance, BSD-licensed Redis fork (in-memory data store).",
  "category": "Databases & caches",
  "icon": "valkey",
  "projectName": "valkey",
  "variables": [
    {
      "key": "DATA_PATH",
      "label": "Data directory (host)",
      "type": "path",
      "hint": null,
      "default": "./valkey-data",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "6379",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "valkey",
      "image": "valkey/valkey:8-alpine",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:6379"
      ],
      "volumes": [
        "${DATA_PATH}:/data"
      ],
      "environment": [],
      "labels": [],
      "command": "valkey-server --save 60 1 --loglevel warning",
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://hub.docker.com/r/valkey/valkey"
}
