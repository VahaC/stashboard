{
  "id": "traefik",
  "name": "Traefik",
  "description": "Cloud-native reverse proxy with Docker auto-discovery.",
  "category": "Networking & proxies",
  "icon": "traefik",
  "projectName": "traefik",
  "variables": [
    {
      "key": "HTTP_PORT",
      "label": "HTTP port",
      "type": "port",
      "hint": null,
      "default": "80",
      "required": false,
      "generate": false
    },
    {
      "key": "DASHBOARD_PORT",
      "label": "Dashboard port",
      "type": "port",
      "hint": null,
      "default": "8080",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "traefik",
      "image": "traefik:v3.1",
      "restart": "unless-stopped",
      "ports": [
        "${HTTP_PORT}:80",
        "${DASHBOARD_PORT}:8080"
      ],
      "volumes": [
        "/var/run/docker.sock:/var/run/docker.sock:ro"
      ],
      "environment": [],
      "labels": [],
      "command": "--api.dashboard=true --api.insecure=true --providers.docker=true --providers.docker.exposedbydefault=false --entrypoints.web.address=:80",
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": "Dashboard on the dashboard port. Mounts the Docker socket read-only to discover containers.",
  "documentation": "https://doc.traefik.io/traefik/"
}
