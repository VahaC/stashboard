{
  "id": "sabnzbd",
  "name": "SABnzbd",
  "description": "The automated Usenet download tool.",
  "category": "Media automation",
  "icon": "sabnzbd",
  "projectName": "sabnzbd",
  "variables": [
    {
      "key": "CONFIG_PATH",
      "label": "Config directory (host)",
      "type": "path",
      "hint": null,
      "default": "./sabnzbd/config",
      "required": false,
      "generate": false
    },
    {
      "key": "DOWNLOADS_PATH",
      "label": "Downloads (host)",
      "type": "path",
      "hint": null,
      "default": "./downloads",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Web UI port",
      "type": "port",
      "hint": null,
      "default": "8080",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "sabnzbd",
      "image": "lscr.io/linuxserver/sabnzbd:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:8080"
      ],
      "volumes": [
        "${CONFIG_PATH}:/config",
        "${DOWNLOADS_PATH}:/downloads"
      ],
      "environment": [
        {
          "name": "PUID",
          "value": "1000"
        },
        {
          "name": "PGID",
          "value": "1000"
        },
        {
          "name": "TZ",
          "value": "Etc/UTC"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://docs.linuxserver.io/images/docker-sabnzbd"
}
