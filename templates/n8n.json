{
  "id": "n8n",
  "name": "n8n",
  "description": "Workflow automation tool — connect anything to everything.",
  "category": "Developer & Git",
  "icon": "n8n",
  "projectName": "n8n",
  "variables": [
    {
      "key": "TZ",
      "label": "Timezone",
      "type": "text",
      "hint": null,
      "default": "Etc/UTC",
      "required": false,
      "generate": false
    },
    {
      "key": "DATA_PATH",
      "label": "Data directory (host)",
      "type": "path",
      "hint": null,
      "default": "./n8n",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "5678",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "n8n",
      "image": "n8nio/n8n:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:5678"
      ],
      "volumes": [
        "${DATA_PATH}:/home/node/.n8n"
      ],
      "environment": [
        {
          "name": "GENERIC_TIMEZONE",
          "value": "${TZ}"
        },
        {
          "name": "TZ",
          "value": "${TZ}"
        },
        {
          "name": "N8N_SECURE_COOKIE",
          "value": "false"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://docs.n8n.io/hosting/installation/docker/"
}
