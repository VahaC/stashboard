{
  "id": "syncthing",
  "name": "Syncthing",
  "description": "Continuous, peer-to-peer file synchronization.",
  "category": "Files & productivity",
  "icon": "syncthing",
  "projectName": "syncthing",
  "variables": [
    {
      "key": "CONFIG_PATH",
      "label": "Config directory (host)",
      "type": "path",
      "hint": null,
      "default": "./syncthing/config",
      "required": false,
      "generate": false
    },
    {
      "key": "DATA_PATH",
      "label": "Data directory (host)",
      "type": "path",
      "hint": null,
      "default": "./syncthing/data",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Web UI port",
      "type": "port",
      "hint": null,
      "default": "8384",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "syncthing",
      "image": "lscr.io/linuxserver/syncthing:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:8384",
        "22000:22000",
        "22000:22000/udp",
        "21027:21027/udp"
      ],
      "volumes": [
        "${CONFIG_PATH}:/config",
        "${DATA_PATH}:/data"
      ],
      "environment": [
        {
          "name": "PUID",
          "value": "1000"
        },
        {
          "name": "PGID",
          "value": "1000"
        },
        {
          "name": "TZ",
          "value": "Etc/UTC"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://docs.linuxserver.io/images/docker-syncthing"
}
