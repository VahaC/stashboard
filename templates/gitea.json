{
  "id": "gitea",
  "name": "Gitea",
  "description": "Painless, lightweight self-hosted Git service.",
  "category": "Developer & Git",
  "icon": "gitea",
  "projectName": "gitea",
  "variables": [
    {
      "key": "DATA_PATH",
      "label": "Data directory (host)",
      "type": "path",
      "hint": null,
      "default": "./gitea",
      "required": false,
      "generate": false
    },
    {
      "key": "HTTP_PORT",
      "label": "HTTP port",
      "type": "port",
      "hint": null,
      "default": "3000",
      "required": false,
      "generate": false
    },
    {
      "key": "SSH_PORT",
      "label": "SSH port",
      "type": "port",
      "hint": null,
      "default": "222",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "gitea",
      "image": "gitea/gitea:latest",
      "restart": "unless-stopped",
      "ports": [
        "${HTTP_PORT}:3000",
        "${SSH_PORT}:22"
      ],
      "volumes": [
        "${DATA_PATH}:/data"
      ],
      "environment": [
        {
          "name": "USER_UID",
          "value": "1000"
        },
        {
          "name": "USER_GID",
          "value": "1000"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://docs.gitea.com/installation/install-with-docker"
}
