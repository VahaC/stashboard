{
  "id": "deluge",
  "name": "Deluge",
  "description": "Full-featured BitTorrent client with a web UI.",
  "category": "Media automation",
  "icon": "deluge",
  "projectName": "deluge",
  "variables": [
    {
      "key": "CONFIG_PATH",
      "label": "Config directory (host)",
      "type": "path",
      "hint": null,
      "default": "./deluge/config",
      "required": false,
      "generate": false
    },
    {
      "key": "DOWNLOADS_PATH",
      "label": "Downloads (host)",
      "type": "path",
      "hint": null,
      "default": "./downloads",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Web UI port",
      "type": "port",
      "hint": null,
      "default": "8112",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "deluge",
      "image": "lscr.io/linuxserver/deluge:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:8112",
        "6881:6881",
        "6881:6881/udp"
      ],
      "volumes": [
        "${CONFIG_PATH}:/config",
        "${DOWNLOADS_PATH}:/downloads"
      ],
      "environment": [
        {
          "name": "PUID",
          "value": "1000"
        },
        {
          "name": "PGID",
          "value": "1000"
        },
        {
          "name": "TZ",
          "value": "Etc/UTC"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://docs.linuxserver.io/images/docker-deluge"
}
