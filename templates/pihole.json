{
  "id": "pihole",
  "name": "Pi-hole",
  "description": "Network-wide ad blocking via a DNS sinkhole with a web UI.",
  "category": "Networking & proxies",
  "icon": "pi-hole",
  "projectName": "pihole",
  "variables": [
    {
      "key": "WEB_PASSWORD",
      "label": "Admin password",
      "type": "password",
      "hint": null,
      "default": null,
      "required": true,
      "generate": true
    },
    {
      "key": "TZ",
      "label": "Timezone",
      "type": "text",
      "hint": null,
      "default": "Etc/UTC",
      "required": false,
      "generate": false
    },
    {
      "key": "CONFIG_PATH",
      "label": "Config directory (host)",
      "type": "path",
      "hint": null,
      "default": "./pihole/etc-pihole",
      "required": false,
      "generate": false
    },
    {
      "key": "WEB_PORT",
      "label": "Web admin port",
      "type": "port",
      "hint": null,
      "default": "8081",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "pihole",
      "image": "pihole/pihole:2024.07.0",
      "restart": "unless-stopped",
      "ports": [
        "53:53/tcp",
        "53:53/udp",
        "${WEB_PORT}:80"
      ],
      "volumes": [
        "${CONFIG_PATH}:/etc/pihole"
      ],
      "environment": [
        {
          "name": "TZ",
          "value": "${TZ}"
        },
        {
          "name": "WEBPASSWORD",
          "value": "${WEB_PASSWORD}"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": "Point your router’s DNS at this host. If port 53 is taken (systemd-resolved), free it first.",
  "documentation": "https://github.com/pi-hole/docker-pi-hole"
}
