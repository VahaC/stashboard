{
  "id": "dozzle",
  "name": "Dozzle",
  "description": "Real-time log viewer for Docker containers — no storage, no setup.",
  "category": "Monitoring & dashboards",
  "icon": "dozzle",
  "projectName": "dozzle",
  "variables": [
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "8080",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "dozzle",
      "image": "amir20/dozzle:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:8080"
      ],
      "volumes": [
        "/var/run/docker.sock:/var/run/docker.sock:ro"
      ],
      "environment": [],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://dozzle.dev/"
}
