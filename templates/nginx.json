{
  "id": "nginx",
  "name": "Nginx",
  "description": "High-performance web server serving static files.",
  "category": "Networking & proxies",
  "icon": "nginx",
  "projectName": "nginx",
  "variables": [
    {
      "key": "HTML_PATH",
      "label": "Site directory (host)",
      "type": "path",
      "hint": null,
      "default": "./html",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "8080",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "web",
      "image": "nginx:1.27-alpine",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:80"
      ],
      "volumes": [
        "${HTML_PATH}:/usr/share/nginx/html:ro"
      ],
      "environment": [],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": "Drop your static site into the html directory above; it is served read-only.",
  "documentation": "https://hub.docker.com/_/nginx"
}
