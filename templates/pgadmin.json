{
  "id": "pgadmin",
  "name": "pgAdmin",
  "description": "Feature-rich administration and development platform for PostgreSQL.",
  "category": "Databases & caches",
  "icon": "pgadmin",
  "projectName": "pgadmin",
  "variables": [
    {
      "key": "EMAIL",
      "label": "Login email",
      "type": "text",
      "hint": null,
      "default": "admin@example.com",
      "required": false,
      "generate": false
    },
    {
      "key": "PASSWORD",
      "label": "Login password",
      "type": "password",
      "hint": null,
      "default": null,
      "required": true,
      "generate": true
    },
    {
      "key": "DATA_PATH",
      "label": "Data directory (host)",
      "type": "path",
      "hint": null,
      "default": "./pgadmin-data",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "8080",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "pgadmin",
      "image": "dpage/pgadmin4:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:80"
      ],
      "volumes": [
        "${DATA_PATH}:/var/lib/pgadmin"
      ],
      "environment": [
        {
          "name": "PGADMIN_DEFAULT_EMAIL",
          "value": "${EMAIL}"
        },
        {
          "name": "PGADMIN_DEFAULT_PASSWORD",
          "value": "${PASSWORD}"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://hub.docker.com/r/dpage/pgadmin4"
}
