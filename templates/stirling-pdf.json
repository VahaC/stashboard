{
  "id": "stirling-pdf",
  "name": "Stirling-PDF",
  "description": "Locally hosted web app to perform many operations on PDF files.",
  "category": "Files & productivity",
  "icon": "stirling-pdf",
  "projectName": "stirlingpdf",
  "variables": [
    {
      "key": "DATA_PATH",
      "label": "Data directory (host)",
      "type": "path",
      "hint": null,
      "default": "./stirling/data",
      "required": false,
      "generate": false
    },
    {
      "key": "CONFIG_PATH",
      "label": "Config directory (host)",
      "type": "path",
      "hint": null,
      "default": "./stirling/config",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "8080",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "stirling-pdf",
      "image": "stirlingtools/stirling-pdf:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:8080"
      ],
      "volumes": [
        "${CONFIG_PATH}:/configs",
        "${DATA_PATH}:/usr/share/tessdata"
      ],
      "environment": [],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://www.stirlingpdf.com/"
}
