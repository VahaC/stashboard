{
  "id": "caddy",
  "name": "Caddy",
  "description": "Modern web server with automatic HTTPS via Let’s Encrypt.",
  "category": "Networking & proxies",
  "icon": "caddy",
  "projectName": "caddy",
  "variables": [
    {
      "key": "CONFIG_PATH",
      "label": "Config directory (host)",
      "type": "path",
      "hint": null,
      "default": "./caddy/config",
      "required": false,
      "generate": false
    },
    {
      "key": "DATA_PATH",
      "label": "Data directory (host)",
      "type": "path",
      "hint": null,
      "default": "./caddy/data",
      "required": false,
      "generate": false
    },
    {
      "key": "HTTP_PORT",
      "label": "HTTP port",
      "type": "port",
      "hint": null,
      "default": "80",
      "required": false,
      "generate": false
    },
    {
      "key": "HTTPS_PORT",
      "label": "HTTPS port",
      "type": "port",
      "hint": null,
      "default": "443",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "caddy",
      "image": "caddy:2",
      "restart": "unless-stopped",
      "ports": [
        "${HTTP_PORT}:80",
        "${HTTPS_PORT}:443"
      ],
      "volumes": [
        "${CONFIG_PATH}:/etc/caddy",
        "${DATA_PATH}:/data"
      ],
      "environment": [],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": "Add a Caddyfile to the config directory to define your sites, then restart.",
  "documentation": "https://hub.docker.com/_/caddy"
}
