{
  "id": "overseerr",
  "name": "Overseerr",
  "description": "Request management and media discovery for Plex.",
  "category": "Media automation",
  "icon": "overseerr",
  "projectName": "overseerr",
  "variables": [
    {
      "key": "CONFIG_PATH",
      "label": "Config directory (host)",
      "type": "path",
      "hint": null,
      "default": "./overseerr",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "5055",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "overseerr",
      "image": "lscr.io/linuxserver/overseerr:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:5055"
      ],
      "volumes": [
        "${CONFIG_PATH}:/config"
      ],
      "environment": [
        {
          "name": "PUID",
          "value": "1000"
        },
        {
          "name": "PGID",
          "value": "1000"
        },
        {
          "name": "TZ",
          "value": "Etc/UTC"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://overseerr.dev/"
}
