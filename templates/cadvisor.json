{
  "id": "cadvisor",
  "name": "cAdvisor",
  "description": "Container resource usage and performance metrics from Google.",
  "category": "Monitoring & dashboards",
  "icon": "google",
  "projectName": "cadvisor",
  "variables": [
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "8080",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "cadvisor",
      "image": "gcr.io/cadvisor/cadvisor:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:8080"
      ],
      "volumes": [
        "/:/rootfs:ro",
        "/var/run:/var/run:ro",
        "/sys:/sys:ro",
        "/var/lib/docker/:/var/lib/docker:ro"
      ],
      "environment": [],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://github.com/google/cadvisor"
}
