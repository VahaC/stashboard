{
  "id": "uptime-kuma",
  "name": "Uptime Kuma",
  "description": "Self-hosted monitoring tool — a fancy uptime dashboard.",
  "category": "Monitoring & dashboards",
  "icon": "uptime-kuma",
  "projectName": "uptimekuma",
  "variables": [
    {
      "key": "DATA_PATH",
      "label": "Data directory (host)",
      "type": "path",
      "hint": null,
      "default": "./uptime-kuma",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "3001",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "uptime-kuma",
      "image": "louislam/uptime-kuma:1",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:3001"
      ],
      "volumes": [
        "${DATA_PATH}:/app/data"
      ],
      "environment": [],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://github.com/louislam/uptime-kuma"
}
