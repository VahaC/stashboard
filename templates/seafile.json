{
  "id": "seafile",
  "name": "Seafile",
  "description": "High-performance file sync and share, with database and cache.",
  "category": "Files & productivity",
  "icon": "seafile",
  "projectName": "seafile",
  "variables": [
    {
      "key": "ADMIN_EMAIL",
      "label": "Admin email",
      "type": "text",
      "hint": null,
      "default": "admin@example.com",
      "required": false,
      "generate": false
    },
    {
      "key": "ADMIN_PASSWORD",
      "label": "Admin password",
      "type": "password",
      "hint": null,
      "default": null,
      "required": true,
      "generate": true
    },
    {
      "key": "DB_ROOT_PASSWORD",
      "label": "Database root password",
      "type": "password",
      "hint": null,
      "default": null,
      "required": true,
      "generate": true
    },
    {
      "key": "DATA_PATH",
      "label": "Seafile data (host)",
      "type": "path",
      "hint": null,
      "default": "./seafile/data",
      "required": false,
      "generate": false
    },
    {
      "key": "DB_DATA_PATH",
      "label": "Database directory (host)",
      "type": "path",
      "hint": null,
      "default": "./seafile/db",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "8000",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "seafile",
      "image": "seafileltd/seafile-mc:11.0-latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:80"
      ],
      "volumes": [
        "${DATA_PATH}:/shared"
      ],
      "environment": [
        {
          "name": "DB_HOST",
          "value": "db"
        },
        {
          "name": "DB_ROOT_PASSWD",
          "value": "${DB_ROOT_PASSWORD}"
        },
        {
          "name": "SEAFILE_ADMIN_EMAIL",
          "value": "${ADMIN_EMAIL}"
        },
        {
          "name": "SEAFILE_ADMIN_PASSWORD",
          "value": "${ADMIN_PASSWORD}"
        },
        {
          "name": "SEAFILE_SERVER_HOSTNAME",
          "value": "localhost"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    },
    {
      "name": "db",
      "image": "mariadb:10.11",
      "restart": "unless-stopped",
      "ports": [],
      "volumes": [
        "${DB_DATA_PATH}:/var/lib/mysql"
      ],
      "environment": [
        {
          "name": "MYSQL_ROOT_PASSWORD",
          "value": "${DB_ROOT_PASSWORD}"
        },
        {
          "name": "MYSQL_LOG_CONSOLE",
          "value": "true"
        }
      ],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    },
    {
      "name": "memcached",
      "image": "memcached:1.6",
      "restart": "unless-stopped",
      "ports": [],
      "volumes": [],
      "environment": [],
      "labels": [],
      "command": "memcached -m 256",
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": "Three services start together. Log in with the admin email/password above.",
  "documentation": "https://manual.seafile.com/docker/deploy_seafile_with_docker/"
}
