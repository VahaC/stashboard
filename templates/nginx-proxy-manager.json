{
  "id": "nginx-proxy-manager",
  "name": "Nginx Proxy Manager",
  "description": "Reverse proxy with a UI and free SSL — no command line needed.",
  "category": "Networking & proxies",
  "icon": "nginx-proxy-manager",
  "projectName": "nginxproxymanager",
  "variables": [
    {
      "key": "DATA_PATH",
      "label": "Data directory (host)",
      "type": "path",
      "hint": null,
      "default": "./npm/data",
      "required": false,
      "generate": false
    },
    {
      "key": "LE_PATH",
      "label": "Let’s Encrypt directory (host)",
      "type": "path",
      "hint": null,
      "default": "./npm/letsencrypt",
      "required": false,
      "generate": false
    },
    {
      "key": "HTTP_PORT",
      "label": "HTTP port",
      "type": "port",
      "hint": null,
      "default": "80",
      "required": false,
      "generate": false
    },
    {
      "key": "HTTPS_PORT",
      "label": "HTTPS port",
      "type": "port",
      "hint": null,
      "default": "443",
      "required": false,
      "generate": false
    },
    {
      "key": "ADMIN_PORT",
      "label": "Admin UI port",
      "type": "port",
      "hint": null,
      "default": "81",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "npm",
      "image": "jc21/nginx-proxy-manager:latest",
      "restart": "unless-stopped",
      "ports": [
        "${HTTP_PORT}:80",
        "${HTTPS_PORT}:443",
        "${ADMIN_PORT}:81"
      ],
      "volumes": [
        "${DATA_PATH}:/data",
        "${LE_PATH}:/etc/letsencrypt"
      ],
      "environment": [],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": "Open the admin port; default login admin@example.com / changeme — change it immediately.",
  "documentation": "https://nginxproxymanager.com/"
}
