{
  "id": "scrypted",
  "name": "Scrypted",
  "description": "High-performance home video integration (HomeKit Secure Video, etc.).",
  "category": "Smart home & IoT",
  "icon": "scrypted",
  "projectName": "scrypted",
  "variables": [
    {
      "key": "DATA_PATH",
      "label": "Data directory (host)",
      "type": "path",
      "hint": null,
      "default": "./scrypted",
      "required": false,
      "generate": false
    },
    {
      "key": "PORT",
      "label": "Exposed port",
      "type": "port",
      "hint": null,
      "default": "11080",
      "required": false,
      "generate": false
    }
  ],
  "services": [
    {
      "name": "scrypted",
      "image": "ghcr.io/koush/scrypted:latest",
      "restart": "unless-stopped",
      "ports": [
        "${PORT}:11080"
      ],
      "volumes": [
        "${DATA_PATH}:/server/volume"
      ],
      "environment": [],
      "labels": [],
      "command": null,
      "entrypoint": null,
      "user": null,
      "workingDir": null,
      "resources": null
    }
  ],
  "notes": null,
  "documentation": "https://docs.scrypted.app/"
}
