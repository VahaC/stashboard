# Copy to `.env` and fill in real values. Never commit `.env`.

# Base64-encoded 32-byte AES-256 key used to encrypt credentials at rest.
# Generate with:  openssl rand -base64 32
STASHBOARD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# JWT signing secret (HMAC-SHA256). Minimum 32 characters.
# Generate with:  openssl rand -base64 48
STASHBOARD_JWT_SECRET=REPLACE_WITH_RANDOM_32+_CHARS

# Host port to expose the app on (default 8080).
STASHBOARD_PORT=8080

# Image version to run. `latest` tracks the newest release; pin a specific
# version for reproducible deploys (e.g. STASHBOARD_TAG=1.2.0).
# Tags: https://hub.docker.com/r/vahac/stashboard/tags
STASHBOARD_TAG=latest
