# Copy to `.env` and fill in real values. Never commit `.env`.

# ── Encryption key + JWT secret (OPTIONAL) ───────────────────────────────────
# Leave both blank and Stashboard generates strong random values on first start,
# persisting them under /app/Data/.secrets on the stashboard-data volume. They
# are preserved across image updates and never overwritten — back up that volume.
#
# Set them explicitly only if you manage secrets yourself or are migrating an
# existing deployment (an explicit value always wins and disables auto-generation
# for that secret). Carry the OLD encryption key over when migrating, or stored
# credentials can no longer be decrypted.
#   STASHBOARD_ENCRYPTION_KEY   Base64-encoded 32-byte key  ->  openssl rand -base64 32
#   STASHBOARD_JWT_SECRET       32+ random chars            ->  openssl rand -base64 48
STASHBOARD_ENCRYPTION_KEY=
STASHBOARD_JWT_SECRET=

# Host port to expose the app on (default 8080).
STASHBOARD_PORT=8080

# Image version to run. `latest` tracks the newest release; pin a specific
# version for reproducible deploys (e.g. STASHBOARD_TAG=6.0.0).
# Tags: https://hub.docker.com/r/vahac/stashboard/tags
STASHBOARD_TAG=latest
