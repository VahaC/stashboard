<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Stable id used by `dotnet user-secrets`. Generated once; never reused for another project. -->
    <UserSecretsId>stashboard-api-2c9f1a14-7f3e-4a0b-8d2a-7f1d2c3e4f56</UserSecretsId>
    <!-- Runtime-written files (the dev SQLite DB + its journal/WAL under Data/, and
         user uploads under wwwroot/uploads/) live inside the project dir. Exclude
         only those artifacts (NOT the Data/ source folder) from the project item set
         so VS's file watcher / Hot Reload doesn't treat a DB write or an upload as a
         project change and kill (restart) the debugged process. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Data\*.db;Data\*.db-*;wwwroot\uploads\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Riok.Mapperly" Version="4.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stashboard.Core\Stashboard.Core.csproj" />
    <ProjectReference Include="..\Stashboard.Infrastructure\Stashboard.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stashboard.Tests" />
  </ItemGroup>

  <!-- User uploads (service logos + container/guest icons) are written into
       wwwroot/uploads/ at runtime. The Web SDK auto-includes wwwroot/** as
       Content, so dotnet watch / Hot Reload would treat a freshly-uploaded file
       as a project change and restart the app — which detaches the debugger
       mid-upload. Exclude the runtime uploads dir from both the build content
       set and the file watcher. Static-file serving is unaffected (it reads the
       physical folder at runtime, independent of these MSBuild items). -->
  <ItemGroup>
    <Content Remove="wwwroot\uploads\**" />
    <Watch Remove="wwwroot\uploads\**" />
    <Content Remove="Data\*.db;Data\*.db-*" />
    <Watch Remove="Data\*.db;Data\*.db-*" />
  </ItemGroup>

  <!-- V7.5 — ship the starter-recipe catalogue with the app. The repo-root
       templates/ folder is copied next to the binaries (dev + tests) and into
       the publish output (the Docker image), so the catalogue loader finds it
       under the app's base directory at runtime. -->
  <ItemGroup>
    <Content Include="..\..\templates\**\*.json"
             Link="templates\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
